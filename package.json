{
  "name": "bloatberg",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply bloatberg --local",
    "db:seed:local": "wrangler d1 execute bloatberg --local --file=migrations/seed.sql",
    "db:build-seed": "bun scripts/build-seed.ts",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && bun run db:migrate:local && bun run db:seed:local",
    "db:migrate:remote": "wrangler d1 migrations apply bloatberg --remote",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "setup": "bun install && bun run db:migrate:local && bun run db:seed:local",
    "art": "bun scripts/art.ts",
    "db:clear-views:local": "wrangler d1 execute bloatberg --local --command \"DELETE FROM article_views; DELETE FROM article_sources;\"",
    "share-cards": "bun scripts/share-cards.ts"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "jose": "^6.2.14",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/old-standard-tt": "^5.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  }
}
